# ============================================================
# SeguraPass
# ============================================================

# Docker image
IMAGE_NAME=segurapass/server
IMAGE_TAG=latest

# Public URL of your SeguraPass installation
SERVER_URL=http://localhost:8080

# Port exposed on the host
SERVER_PORT=8080


# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_DB=segurapass
POSTGRES_USER=segurapass

# CHANGE THIS
POSTGRES_PASSWORD=change-me


# ============================================================
# TOTP encryption
# ============================================================

# Generated automatically by second start.sh run (after .env is generated).
# User does not have to enter anything here.
# Must remain unchanged for the lifetime of the installation.
# 32 bytes / 64 hexadecimal characters.
TOTP_SECRET_ENCRYPTION_KEY=


# ============================================================
# Email
# ============================================================

# Email functionality is disabled by default.
EMAIL_SERVICE_ACTIVE=false

# Only required when email functionality is enabled.
# Set this to the base URL of the service running your email logic.
EMAIL_SERVICE_URL=

# CHANGE THIS if email functionality is enabled
# and your application requires a stable salt for email hashing.
EMAIL_HASH_SALT=


# ============================================================
# Rate limiting
# ============================================================

IP_LIMITING_ENABLED=false
DEFAULT_LIMITING_SECONDS=60