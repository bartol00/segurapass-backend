<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-05-15-01-user-entity-vault-key" author="bartol">
        <addColumn tableName="users" schemaName="password_manager">
            <column name="vault_key" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="iv_vault_key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
    <changeSet id="2026-05-15-02-credential-entity-created-at" author="bartol">
        <addColumn tableName="credentials" schemaName="password_manager">
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
