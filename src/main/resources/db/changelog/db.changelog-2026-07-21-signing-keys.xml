<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-07-21-01-user-entity-signing-key" author="bartol">
        <addColumn tableName="users" schemaName="password_manager">
            <column name="salt_hkdf" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="private_signing_key" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="public_signing_key" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="iv_private_signing_key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
