<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-08-08-01-totp-entity" author="bartol">
        <createTable tableName="totp">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="totp_pkey"/>
            </column>
            <column name="totp_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="encrypted_token" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="token_iv" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="user_entity_id" type="BIGINT"/>
        </createTable>
    </changeSet>

    <changeSet id="2026-08-08-02-totp-entity" author="bartol">
        <addColumn tableName="users" schemaName="password_manager">
            <column name="mfa_enabled" type="BOOLEAN"/>
            <column name="mfa_recovery_code" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-08-08-03-totp-entity" author="bartol">
        <dropColumn tableName="totp">
            <column name="totp_id"/>
        </dropColumn>
    </changeSet>

    <changeSet id="2026-08-11-01-totp-entity" author="bartol">
        <dropColumn tableName="users">
            <column name="mfa_enabled" type="BOOLEAN"/>
        </dropColumn>
        <addColumn tableName="users" schemaName="password_manager">
            <column name="totp_enabled" type="BOOLEAN"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
